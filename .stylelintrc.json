{
  "extends": "@saji/stylelint-config",
  "rules": {
    "selector-type-no-unknown": null,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "container",
          "container-name",
          "container-type"
        ]
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "container",
          "starting-style"
        ]
      }
    ],
    "length-zero-no-unit": [
      true,
      {
        "ignore": ["custom-properties"]
      }
    ],
    "unit-no-unknown": [
      true,
      {
        "ignoreUnits": ["dvh", "cqi", "cqb", "cqmin", "cqmax"]
      }
    ]
  }
}
